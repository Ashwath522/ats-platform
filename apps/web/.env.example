# Browser and server requests use the same-origin /api route in every environment.
NEXT_PUBLIC_APP_NAME=CoreLink AI
DATABASE_URL=postgresql://user:password@localhost:5432/db_name
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OpenRouter (server-only — set in .env.local, never commit)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=CoreLink

# Resend Email (server-only — set in .env.local, never commit)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=CoreLink <notifications@yourdomain.test>
