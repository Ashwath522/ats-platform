# Copy this file to .env and fill in real values before deploying.
# Local dev works fine without a .env file at all (safe defaults kick in).

# Secret used to sign recruiter JWTs. MUST be set to a long random value in
# any real deployment - if unset, a dev-only fallback is used and all
# existing tokens are invalidated on every restart.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins. Defaults to "*" (any
# origin) if unset - fine for local dev, must be locked down before deploying
# publicly, e.g.:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=*

# Gemini (free tier) — used for deep analysis and resume suggestions.
# Do not commit a real key. Set this locally or in your deployment secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email delivery. Never commit real values. Provider is picked from
# EMAIL_PROVIDER (brevo|resend|smtp|console) or automatically in the order
# brevo -> resend -> smtp based on which keys are set. Render's free tier
# blocks outbound SMTP ports, so prefer an HTTP API provider there.
# DEV_MODE=true lets demo flows return OTP/reset tokens in API responses if
# no provider is configured or delivery fails.
EMAIL_PROVIDER=
# EMAIL_FROM must be a verified sender with your provider.
EMAIL_FROM=
EMAIL_FROM_NAME=CoreLink Hiring
# Brevo: app.brevo.com -> SMTP & API -> API keys (300 emails/day free).
BREVO_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
# SMTP_PORT 465 = implicit SSL, anything else = STARTTLS.
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
DEV_MODE=false

# Public URL of the frontend, used for links inside emails.
APP_PUBLIC_URL=http://localhost:5173
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Recruiter company verification does DNS (MX) and HTTPS website checks.
# Defaults to on (off under tests); set to 0 to disable the network checks.
RECRUITER_VERIFY_NETWORK=

# Optional first admin bootstrap. No hardcoded admin password exists in code.
# ADMIN_EMAIL also receives "new recruiter request" notifications.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Database ────────────────────────────────────────────────────────────────
# Unset → local SQLite in backend/data. For hosting use a free Neon Postgres:
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/corelink?sslmode=require
DATABASE_URL=

# ── Storage on hosts without a persistent disk (Render free) ────────────────
# VECTOR_BACKEND=db  → resume embeddings stored in the SQL database (default when DATABASE_URL is set)
# MEDIA_STORE=db     → avatars / covers / certificates mirrored into the database
VECTOR_BACKEND=
MEDIA_STORE=
# fastembed (ONNX, ~150 MB RAM, default) | sentence-transformers (needs requirements-ml.txt)
EMBEDDING_BACKEND=

# ── AI interviewer (server-side, streaming) ────────────────────────────────
# Any one of these is enough; they are tried in INTERVIEW_LLM_ORDER and the
# interview falls back to a scripted interviewer if none respond.
GROQ_API_KEY=
OPENROUTER_API_KEY=
INTERVIEW_LLM_ORDER=groq,gemini,openrouter,ollama
# Models (defaults shown)
# INTERVIEW_GROQ_FAST_MODEL=llama-3.1-8b-instant      # live turns: lowest latency
# INTERVIEW_GROQ_SMART_MODEL=llama-3.3-70b-versatile  # final evaluation
# INTERVIEW_GEMINI_FAST_MODEL=gemini-2.0-flash
# Max wait for a provider's first token before failing over (seconds)
INTERVIEW_TTFT_BUDGET_S=3.5

# ── Live jobs & resources (official APIs only; all optional) ───────────────
# Shared secret for the scheduled POST /api/internal/live-sync (header X-Sync-Token).
LIVE_SYNC_AUTO=true
LIVE_SYNC_INTERVAL_HOURS=6
KEEP_AWAKE=true
LIVE_SYNC_TOKEN=
# Adzuna (free): https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble (free): https://jooble.org/api/about
JOOBLE_API_KEY=
# YouTube Data API v3 (free): https://console.cloud.google.com
YOUTUBE_API_KEY=

# Sign in with Google: OAuth "Web application" client id (no secret needed)
GOOGLE_CLIENT_ID=
