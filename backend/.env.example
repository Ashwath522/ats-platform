# Copy this file to .env and fill in real values before deploying.
# Local dev works fine without a .env file at all (safe defaults kick in).

# Secret used to sign recruiter JWTs. MUST be set to a long random value in
# any real deployment - if unset, a dev-only fallback is used and all
# existing tokens are invalidated on every restart.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins. Defaults to "*" (any
# origin) if unset - fine for local dev, must be locked down before deploying
# publicly, e.g.:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=*

# Optional, used only when the candidate clicks "Get full analysis".
# Do not commit a real key. Set this locally or in your deployment secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
