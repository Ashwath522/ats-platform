# Copy this file to .env and fill in real values before deploying.
# Local dev works fine without a .env file at all (safe defaults kick in).

# Secret used to sign recruiter JWTs. MUST be set to a long random value in
# any real deployment - if unset, a dev-only fallback is used and all
# existing tokens are invalidated on every restart.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins. Defaults to "*" (any
# origin) if unset - fine for local dev, must be locked down before deploying
# publicly, e.g.:
# CORS_ORIGINS=https://your-frontend-domain.com
CORS_ORIGINS=*

# Gemini (free tier) — used for deep analysis and resume suggestions.
# Do not commit a real key. Set this locally or in your deployment secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email delivery. Use an app password/provider SMTP credential; never commit
# real values. DEV_MODE=true lets demo flows return OTP/reset tokens in API
# responses if SMTP is unset or fails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
DEV_MODE=false

# Optional first admin bootstrap. No hardcoded admin password exists in code.
ADMIN_EMAIL=
ADMIN_PASSWORD=
